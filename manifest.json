{
  "manifest_version": 3,
  "name": "AV.by Валюты",
  "version": "1.1.0",
  "description": "Замена цен на AV.by из BYN в выбранную валюту с курсами НБРБ.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://api.nbrb.by/*",
    "https://av.by/*",
    "https://*.av.by/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "AV.by Валюты",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://av.by/*", "https://*.av.by/*"],
      "js": ["content/avby.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "av-by-currencies@redpandadev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
