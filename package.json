{
  "name": "av-currencies",
  "type": "module",
  "scripts": {
    "test": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' 'src/background.js' 'scripts/**/*.mjs' 'tests/**/*.js' 'worker/src/**/*.ts' 'manifest.json'",
    "format:check": "prettier --check 'src/**/*.js' 'scripts/**/*.mjs' 'tests/**/*.js' 'worker/src/**/*.ts' 'manifest.json'",
    "package:chrome": "node scripts/build-chrome.mjs",
    "package:firefox": "node scripts/build-firefox.mjs",
    "package": "npm run package:chrome && npm run package:firefox"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.8"
  }
}
