{
  "name": "av-currencies",
  "type": "module",
  "scripts": {
    "test": "vitest run --coverage",
    "format": "prettier --write 'src/lib/**/*.js' 'src/content/**/*.js' 'src/background.js' 'src/popup/**/*.js' 'src/popup/**/*.html' 'src/popup/**/*.css' 'scripts/**/*.mjs' 'tests/**/*.js' 'manifest.json'",
    "format:check": "prettier --check 'src/lib/**/*.js' 'src/content/**/*.js' 'src/background.js' 'src/popup/**/*.js' 'src/popup/**/*.html' 'src/popup/**/*.css' 'scripts/**/*.mjs' 'tests/**/*.js' 'manifest.json'",
    "package:chrome": "node scripts/build-chrome.mjs",
    "package:firefox": "node scripts/build-firefox.mjs",
    "package": "npm run package:chrome && npm run package:firefox"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  }
}
