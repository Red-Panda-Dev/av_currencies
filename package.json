{
  "name": "av-currencies",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.js' 'src/background.js' 'scripts/**/*.mjs' 'tests/**/*.js' 'worker/src/**/*.ts' 'ios/**/*.js' 'manifest.json'",
    "format:check": "prettier --check 'src/**/*.js' 'scripts/**/*.mjs' 'tests/**/*.js' 'worker/src/**/*.ts' 'ios/**/*.js' 'manifest.json'",
    "package:chrome": "node scripts/build-chrome.mjs",
    "package:firefox": "node scripts/build-firefox.mjs",
    "package": "npm run package:chrome && npm run package:firefox"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
